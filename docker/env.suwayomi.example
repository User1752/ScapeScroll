# Copia este ficheiro para ".env.suwayomi" (na mesma pasta) e muda os valores. Sem aspas.
# O ".env.suwayomi" nao vai para o git. Usa uma password longa e que nao uses em mais lado nenhum
# (nem a Access Password do ScrollScape).
AUTH_USERNAME=scrollscape
AUTH_PASSWORD=muda-isto-para-uma-password-longa
